# systemd unit template. Adjust User/Group and the /opt/tokens-meter paths, then:
#   sudo cp backend.service /etc/systemd/system/tokens-meter-backend.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now tokens-meter-backend
[Unit]
Description=tokens-meter usage backend
After=network.target

[Service]
Type=simple
User=tokens-meter
Group=tokens-meter
WorkingDirectory=/opt/tokens-meter/backend
ExecStart=/usr/bin/python3 /opt/tokens-meter/backend/backend.py --config /opt/tokens-meter/backend/config.json
Restart=on-failure
RestartSec=3

# Hardening: the service only needs to write its own data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/opt/tokens-meter/backend/data
UMask=0077

[Install]
WantedBy=multi-user.target
