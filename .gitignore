# PlatformIO build artifacts
firmware/.pio/
firmware/.vscode/

# OTA pull TLS material — real infrastructure stays out of the repo.
# The pinned self-signed server cert (SAN carries the update host's IP) is a
# local, untracked secret; gen_pinned_cert.py turns it into a generated header.
# A clean checkout/CI still builds via the generated fail-closed placeholder.
# Keep any tracked example deliberately (e.g. *.example.pem) by not matching it
# here.
firmware/certs/pinned_server.pem
firmware/src/certs/pinned_server_pem.h
# Signed-update pin (design/ota-pull/SIGNING.md section 5): the public half of
# the ECDSA P-256 signing key is local/untracked and generated into a header by
# gen_pinned_cert.py. Absent -> an empty SIGNING_PUBKEY_PEM (hash-only build).
firmware/certs/signing_pubkey.pem
firmware/src/certs/signing_pubkey_pem.h
# Backend-WiFi usage pull config (design/backend-wifi/PHASE1-CONTRACT.md section 7):
# the backend URL and the per-device bearer token are injected as build macros by
# scripts/gen_usage_config.py. The token is a credential — never commit it.
firmware/certs/usage_backend.json
*.key

# Editor settings
.vscode/

# OS
.DS_Store

# Claude Code
.claude/

# Node tooling deps (npm install --no-save)
tools/node_modules/
tools/package-lock.json

# Mac daemon venv
daemon/.venv/

# Python bytecode cache
__pycache__/
*.pyc

# Local working notes — decision records and debug scratch from design
# sessions. They quote real portfolio figures, so they stay out of the public
# repo. The masked prototype under design/opencode-screen/ is the artifact
# that carries the screen itself.
#
# One exception is tracked on purpose: the standalone-backend decision log
# (architecture only, no figures). Everything else under this folder stays
# local.
cooked-ideas/*
!cooked-ideas/pasar-device-a-backend-wifi.md

# Herdr subagent helper, local tooling, not part of the project
.herdr-wait-agent.sh
