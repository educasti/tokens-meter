# Caddy v2 site block for pull-based automatic OTA.
#
# Serves the static firmware directory over HTTPS with an explicit self-signed
# certificate. The update host is a BARE PUBLIC IP (the owner's reserved Oracle
# Cloud VM address), so ACME / Let's Encrypt cannot be used: no CA issues
# certificates for a bare IP. The firmware pins this exact certificate with
# WiFiClientSecure::setCACert and keeps verification on (design/ota-pull/DESIGN.md
# sections 4, 6 and 8; the backend direction is design/backend-wifi/ROADMAP.md
# D8 and section 10).
#
# This is an example: replace 192.0.2.10 (TEST-NET-1, a documentation-only
# address) with the real VM IP, and /srv with the real document root (the
# publish script writes to <root>/firmware/<board>/).
#
# Prerequisites (ROADMAP.md section 10):
#   - a reserved/static public IP; no DNS name is needed;
#   - a self-signed cert/key whose SAN contains that IP, e.g.
#       openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
#         -keyout /etc/caddy/ota.key -out /etc/caddy/ota.crt \
#         -subj "/CN=ota" -addext "subjectAltName=IP:<the.vm.ip>"
#     (ota.crt is the PEM pinned in firmware; both files stay out of the repo);
#   - port 443 open in BOTH the VPC Security List and the image's iptables;
#   - Caddy does NOT need :80 or ACME; TLS comes from the explicit certificate.

192.0.2.10 {
	# Explicit self-signed certificate; no ACME, no hostname.
	tls /etc/caddy/ota.crt /etc/caddy/ota.key

	# Compress JSON; firmware binaries are already compressed and will not shrink.
	encode zstd gzip

	# Static root. /srv is the document root and the published files live in
	# /srv/firmware, so the public /firmware/<board>/... URLs map onto disk
	# (DESIGN section 6.4):
	#   URL  /firmware/<board>/manifest.json
	#   disk /srv/firmware/<board>/manifest.json
	root * /srv

	# --- Security headers (static files only; no dynamic backend) -------------
	# No HSTS: browsers ignore it for bare-IP hosts and there is no domain.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# --- Manifest: always revalidate; file_server emits ETag/Last-Modified ----
	# The device sends If-None-Match and treats 304 as "no update".
	@manifest path */manifest.json
	header @manifest Cache-Control "no-cache"

	# --- Firmware binaries: content-addressed by version, cache forever -------
	@bin path *.bin
	header @bin Content-Type "application/octet-stream"
	header @bin Cache-Control "public, max-age=31536000, immutable"

	# --- Single-board alias (owner-facing convenience path) -------------------
	# /firmware/manifest.json -> the canonical per-board manifest. Prefer this
	# rewrite over a filesystem symlink: no symlink-following ambiguity.
	handle /firmware/manifest.json {
		rewrite * /firmware/waveshare_amoled_216/manifest.json
		file_server
	}

	# Everything else under the root is served directly (manifest + binaries).
	handle {
		file_server
	}

	log {
		output file /var/log/caddy/ota-access.log
		format json
	}
}
