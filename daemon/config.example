# Clawdmeter daemon config
#
# Copy this file to:
#   macOS / Linux : ~/.config/claude-usage-monitor/config
#   Windows       : %LOCALAPPDATA%\Clawdmeter\config
#
# The daemon re-reads it on every poll, so edits take effect within ~60s — no restart needed.

# Poll more than one Claude config dir and show whichever plan is currently
# active. Use this if you run separate plans from different config dirs (e.g. a
# personal plan in ~/.claude and a work plan in ~/.claude-work, selected via
# CLAUDE_CONFIG_DIR). Comma-separated; ~ is expanded.
#   - The daemon polls every listed dir each cycle and displays the plan whose
#     usage rose most recently (i.e. the one you're actively using). Before any
#     change is seen it shows the plan with the highest current usage.
#   - Unset (default) = just ~/.claude, unchanged single-plan behavior.
#   - install.sh can detect your ~/.claude* dirs and fill this in for you.
# config_dirs = ~/.claude, ~/.claude-work

# Seconds between Anthropic API polls (Linux daemon). Default 60. Minimum 10.
# The firmware marks data older than 90s as stale and only updates its "resets
# in" countdown when a payload lands, so anything above ~80 relies on the
# heartbeat below to keep the display live.
# poll_interval = 60

# Seconds between heartbeat replays of the last payload while waiting for the
# next API poll (Linux daemon). The replay ages the reset countdowns and clock
# so the display stays accurate without an API call. Default 60. Minimum 10.
# Set it >= poll_interval to disable.
# heartbeat_interval = 60

# Play a sound on the device when your 5-hour session limit resets, so you know
# you can use Claude again without watching the screen.
#   off = silent (default)
#   on  = chime through the board speaker (boards with audio: AMOLED-2.16 / 1.8)
chime = off
# Show a clock on the Usage screen, in place of the "Usage" title.
#   off  = no clock; the screen keeps showing "Usage" (default)
#   auto = show the clock, auto-detecting 12h/24h from this machine's settings
#          (detection can default to 24h when the daemon runs under launchd/systemd
#           with no locale — set 12 or 24 explicitly below if auto guesses wrong)
#   12   = show the clock, forced 12-hour  (e.g. 6:28 PM)
#   24   = show the clock, forced 24-hour  (e.g. 18:28)
clock = off

# Send the OpenCode usage screens as well (macOS daemon). When on, the daemon
# polls OpenCode every 60s — independently of Claude, so the OpenCode screens
# keep working even when Claude has no token — and sends its payload 250ms
# after the Claude one.
#   off = Claude screens only (default, and the only ones in the screen cycle)
#   on  = the OpenCode splash + usage screens join the cycle
# With `off` the device behaves exactly as before.
opencode = off
# Optional: point the daemon at a non-standard OpenCode install. Both are
# optional and default to the standard locations; ~ is expanded.
#   opencode_db   = ~/.local/share/opencode/opencode.db  (read-only, WAL-aware)
#   opencode_auth = ~/.local/share/opencode/auth.json    (holds the Go key)
# opencode_db = ~/.local/share/opencode/opencode.db
# opencode_auth = ~/.local/share/opencode/auth.json

# Send the BVC portfolio screen as well (macOS daemon). When on, the daemon
# polls Yahoo every 60s — independently of Claude, so the screen keeps working
# even when Claude has no token — and sends its payload between the Claude and
# OpenCode ones. No API key, no account, no cost: one public request per poll.
#   off = the screen stays out of the cycle (default)
#   on  = the portfolio screen joins the cycle
# Positions live in their own file, one per line, re-read on every poll so an
# edit lands in ~60s without a restart:
#   ALPHA.CL 150
#   BETAGROUP.CL 300
#   # blank lines and # comments are fine
# Symbols go to Yahoo VERBATIM — do not let the daemon guess a suffix for you.
# "EPM.CL" is a ticker Yahoo does not know; "EPM" answers with a US oil company
# at USD 3.50, which is why the daemon only accepts quotes whose exchange is
# BVC and reports the rest as "sin precio" instead of showing you the wrong
# company. Quantities must be positive numbers. A duplicated symbol keeps its
# first line; anything the file gets wrong is written to the log.
portfolio = off
# Optional: point the daemon at a different positions file. Defaults to
# ~/.config/claude-usage-monitor/portfolio; ~ is expanded.
# portfolio_path = ~/.config/claude-usage-monitor/portfolio

# --- Hybrid OTA (daemon/ota_flash.py) ---------------------------------------
# These keys are ONLY read by the OTA helper, never by the running daemon. They
# supply defaults for its CLI flags; any flag given on the command line wins.
#
# ota_ssid          = WiFi network the device should join for the upload.
#                     Equivalent to `--ssid`.
# ota_wifi_password = Password for ota_ssid. Equivalent to `--pass`.
# ota_password      = Shared ArduinoOTA password; passed to the device's `ota`
#                     command and to espota via `-a`. Equivalent to
#                     `--ota-password`. Leave unset for no shared password.
#
# Example:
# ota_ssid = MyHomeWiFi
# ota_wifi_password = hunter2
# ota_password = ota-shared-secret
#
# Flash with the defaults above:
#   python daemon/ota_flash.py \
#       --firmware firmware/.pio/build/waveshare_amoled_216/firmware.bin
# or override the SSID for one run:
#   python daemon/ota_flash.py --firmware ... --ssid Guest --pass guestpw
